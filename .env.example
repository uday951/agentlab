# ============================================================
# AGENTLAB ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure the variables below.
# ============================================================

# Server Environment & Port
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Database (MongoDB with Mongoose)
# Real MongoDB connection string (e.g., local MongoDB or MongoDB Atlas).
# Mandatory: If not configured, the platform explicitly signals database unconfigured state.
MONGODB_URI=mongodb://localhost:27017/agentlab

# Security & Authentication
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars
ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_credential_encryption

# Built-in or External LLM Provider (Optional)
# The application works out-of-the-box without external keys using the Built-in Sample Support Agent.
LLM_PROVIDER=builtin-deterministic
LLM_API_KEY=
LLM_MODEL=

# GitHub Repository Inspection & Import (Optional)
# Used to inspect public/private GitHub repositories for entrypoint analysis.
GITHUB_TOKEN=

# Isolated Agent Runner Service (Optional - for GitHub/ZIP imported projects)
# When configured, points to an isolated Docker worker or container execution runner.
# If unconfigured, the platform explicitly reports that isolated execution is required.
AGENT_RUNNER_URL=
AGENT_RUNNER_TOKEN=

# Local CLI Execution Sandbox (Security Gate)
# Must be explicitly set to 'true' to allow CLI agents to execute approved command binaries.
ENABLE_CLI_RUNNER=false
